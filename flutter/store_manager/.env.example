# ── API (composed as: HTTP_SCHEME://BASE_URL + API_PATH + API_VERSION) ──
# UNCOMMENT EXACTLY ONE pair below, then FULL STOP + REBUILD.
# (.env is a build-time asset — hot reload/restart will NOT pick up a change.)
# Android emulator rewrites localhost → 10.0.2.2 automatically.

# ── 1. EMULATOR (or iOS simulator / macOS) — backend on this Mac ──────────
HTTP_SCHEME=http
BASE_URL=localhost:5099

# ── 2. REAL DEVICE — backend on this Mac, over Wi-Fi ──────────────────────
# HTTP_SCHEME=http
# BASE_URL=192.168.1.16:5099

API_PATH=/api
API_VERSION=/v1
