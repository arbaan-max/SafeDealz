{
  "openapi": "3.0.3",
  "info": {"title": "SafeDealz API", "version": "0.1.0"},
  "servers": [{"url": "http://localhost:5099/api/v1"}],
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/HealthResponse"}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["success", "data"],
        "properties": {
          "success": {"type": "boolean"},
          "data": {
            "type": "object",
            "required": ["status"],
            "properties": {"status": {"type": "string", "example": "ok"}}
          }
        }
      }
    }
  }
}
