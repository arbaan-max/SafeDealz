{
  "openapi": "3.0.3",
  "info": {"title": "SafeDealz API", "version": "0.2.0"},
  "servers": [{"url": "http://localhost:5099/api/v1"}],
  "paths": {
    "/health": {"get": {"tags": ["System"], "operationId": "getHealth", "responses": {"200": {"description": "Service health", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthResponse"}}}}}}},
    "/auth/login": {"post": {"tags": ["Auth"], "operationId": "login", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginRequest"}}}}, "responses": {"200": {"description": "Authenticated session", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthResponse"}}}}, "400": {"$ref": "#/components/responses/ApiError"}, "401": {"$ref": "#/components/responses/ApiError"}, "429": {"$ref": "#/components/responses/ApiError"}}}},
    "/auth/refresh": {"post": {"tags": ["Auth"], "operationId": "refresh", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RefreshRequest"}}}}, "responses": {"200": {"description": "Rotated session", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthResponse"}}}}, "400": {"$ref": "#/components/responses/ApiError"}, "401": {"$ref": "#/components/responses/ApiError"}, "403": {"$ref": "#/components/responses/ApiError"}}}},
    "/auth/logout": {"post": {"tags": ["Auth"], "operationId": "logout", "security": [{"bearerAuth": []}], "responses": {"204": {"description": "Session revoked"}, "401": {"$ref": "#/components/responses/ApiError"}}}},
    "/auth/me": {"get": {"tags": ["Auth"], "operationId": "getCurrentAccount", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "Current account", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AccountResponse"}}}}, "401": {"$ref": "#/components/responses/ApiError"}}}}
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "responses": {"ApiError": {"description": "Standard error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}},
    "schemas": {
      "AccountRole": {"type": "string", "enum": ["super_admin", "admin", "store_manager", "vendor"]},
      "LoginAudience": {"type": "string", "enum": ["admin_portal", "store_manager", "vendor"]},
      "ClientType": {"type": "string", "enum": ["web", "mobile"]},
      "AccountSummary": {"type": "object", "required": ["id", "email", "role"], "properties": {"id": {"type": "string"}, "email": {"type": "string", "format": "email"}, "role": {"$ref": "#/components/schemas/AccountRole"}}},
      "LoginRequest": {"type": "object", "required": ["email", "password", "expectedRole", "clientType"], "properties": {"email": {"type": "string", "format": "email"}, "password": {"type": "string", "format": "password"}, "expectedRole": {"$ref": "#/components/schemas/LoginAudience"}, "clientType": {"$ref": "#/components/schemas/ClientType"}}},
      "RefreshRequest": {"type": "object", "required": ["clientType"], "properties": {"clientType": {"$ref": "#/components/schemas/ClientType"}, "refreshToken": {"type": "string"}}},
      "AuthData": {"type": "object", "required": ["accessToken", "expiresIn", "account"], "properties": {"accessToken": {"type": "string"}, "refreshToken": {"type": "string"}, "csrfToken": {"type": "string"}, "expiresIn": {"type": "integer"}, "account": {"$ref": "#/components/schemas/AccountSummary"}}},
      "AuthResponse": {"type": "object", "required": ["success", "data"], "properties": {"success": {"type": "boolean"}, "data": {"$ref": "#/components/schemas/AuthData"}}},
      "AccountResponse": {"type": "object", "required": ["success", "data"], "properties": {"success": {"type": "boolean"}, "data": {"$ref": "#/components/schemas/AccountSummary"}}},
      "ErrorBody": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}},
      "ErrorResponse": {"type": "object", "required": ["success", "error"], "properties": {"success": {"type": "boolean"}, "error": {"$ref": "#/components/schemas/ErrorBody"}}},
      "HealthResponse": {"type": "object", "required": ["success", "data"], "properties": {"success": {"type": "boolean"}, "data": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string", "example": "ok"}}}}}
    }
  }
}
