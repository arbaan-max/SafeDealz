# Switch with API_TARGET, then FULL STOP + REBUILD.
# (.env is a build-time asset — hot reload will NOT pick up a change.)
# Android emulator rewrites local localhost → 10.0.2.2 automatically.

# local = Mac backend on port 5099
# live  = Railway production
API_TARGET=local

LOCAL_HTTP_SCHEME=http
LOCAL_BASE_URL=localhost:5099
# For a real phone on Wi-Fi, use your Mac LAN IP instead:
# LOCAL_BASE_URL=192.168.1.16:5099

LIVE_HTTP_SCHEME=https
LIVE_BASE_URL=safedealz-production.up.railway.app

API_PATH=/api
API_VERSION=/v1
