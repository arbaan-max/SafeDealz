# Restart `npm run dev` after changing this file. Hot reload is not enough.

# UNCOMMENT EXACTLY ONE target below.

# ── LOCAL TESTING ────────────────────────────────────────────────────────
# Use this with `npm run dev` and a backend running on this Mac (port 5099).
# Vite proxies /api to http://127.0.0.1:5099
VITE_API_TARGET=local
VITE_LOCAL_API_BASE_URL=/api/v1

# ── LIVE TESTING ─────────────────────────────────────────────────────────
# Use this with `npm run dev` to hit Railway from this Mac.
# Comment the LOCAL block above, then uncomment these two lines.
# VITE_API_TARGET=live
# VITE_LIVE_API_BASE_URL=https://safedealz-production.up.railway.app/api/v1

# ── LIVE BUILD ───────────────────────────────────────────────────────────
# Do not change this file for `npm run build`.
# Production builds read `.env.production`, which already points at Railway.

# Kept for older local setups that still read this key.
VITE_API_BASE_URL=/api/v1

